__pycache__/
*.pyc
.venv/
.DS_Store
.mypy_cache/
.ruff_cache/
.pytest_cache/
out/
temp/

# Fixture media is NOT committed by default. A clip of a person - body and room
# identify someone perfectly well without a face in shot - must not enter git
# history, where removing it later is expensive. Un-ignore a specific fixture
# deliberately, once it has been confirmed to show hands only.
fixtures/*.mp4
fixtures/*.mov

# Core ML models are NOT committed. 47 MB of weights that Apple already hosts would be
# in every clone, every fork and every diff of a repository meant to be cloned. Get
# them with `./tools/fetch_models.sh`; docs/DEPTH.md is the first-run guide. The
# compiled .mlmodelc is a build product of the .mlpackage and is equally not ours.
models/

# TouchDesigner writes a numbered backup beside every .toe on save, and a Backup/
# folder next to it. Committing those would put dozens of near-identical binaries in
# the history of a repo that ships example projects.
*.toe.[0-9]*
*.tox.[0-9]*
Backup/

# The local MCP bridge config. No secrets in it, but it is a dev-environment file -
# it describes how THIS machine drives TouchDesigner, not anything a user needs.
.mcp.json
